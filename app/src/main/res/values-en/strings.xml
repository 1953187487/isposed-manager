    <!-- intro -->
    <string name="intro_title">Isposed Manager</string>
    <string name="intro_tagline">Rootless Xposed / LSPosed manager</string>
    <string name="intro_desc">Built on the LSPosed framework. Once activated you can manage modules, configure scopes and run Shell commands on the device.</string>
    <string name="intro_feature_1_title">Rootless activation</string>
    <string name="intro_feature_1_desc">Wireless pairing, plain TCP and command parsing share one persistent ADB identity.</string>
    <string name="intro_feature_2_title">Modules and scopes</string>
    <string name="intro_feature_2_desc">Module discovery, toggling and per app scope management are reimplemented on top of the LSPosed daemon interface.</string>
    <string name="intro_feature_3_title">Shell and AI</string>
    <string name="intro_feature_3_desc">The built-in terminal runs commands on the device, and any Xposed module source can be converted into an installable project.</string>
    <string name="intro_cta">Get started</string>
