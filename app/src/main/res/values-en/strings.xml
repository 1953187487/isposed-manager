    <string name="about_section_framework">Foundation framework</string>
    <string name="about_framework_title">LSPosed Framework</string>
    <string name="about_framework_sub">GPL-3.0 · Android 8.1 ~ 14</string>
    <string name="about_framework_desc">This app is developed on top of LSPosed Framework, which provides the runtime and injection foundation. LSPosed is a Riru / Zygisk module built on LSPlant and exposes the same ART hook interface as the original Xposed.</string>
    <string name="about_framework_desc2">Module detection, scopes and daemon interfaces come from the stable LSPosed interfaces. All management capabilities are reimplemented on top of them, following the upstream GPL-3.0 terms and keeping the copyright notices.</string>
    <string name="about_section_features">Rewritten module features</string>
    <string name="about_feature_1_title">Module detection and management</string>
    <string name="about_feature_1_desc">Module discovery, toggling and status management reimplemented on the LSPosed daemon interface</string>
    <string name="about_feature_2_title">Scope configuration</string>
    <string name="about_feature_2_desc">Per app scope selection and persistence, rewritten as local data driven</string>
    <string name="about_feature_3_title">Three activation channels</string>
    <string name="about_feature_3_desc">Wireless pairing, plain TCP and command parsing share one persistent ADB identity</string>
    <string name="about_feature_4_title">Shell and debugging</string>
    <string name="about_feature_4_desc">The built-in terminal runs commands on the device, and module push, install and scope delivery use the same local channel</string>
    <string name="about_feature_5_title">AI conversion</string>
    <string name="about_feature_5_desc">Turn existing Xposed module source into an installable project with one tap</string>
    <string name="about_feature_6_title">AI development</string>
    <string name="about_feature_6_desc">Let AI generate a complete LSPosed module project</string>
    <string name="about_feature_7_title">Updates and onboarding</string>
    <string name="about_feature_7_desc">Checks for a new version on entry, then shows the changelog and walks through the agreement again after an update</string>
    <string name="about_feature_8_title">App authorization</string>
    <string name="about_feature_8_desc">Grant Shell capability per app, accept external access requests and revoke at any time</string>
